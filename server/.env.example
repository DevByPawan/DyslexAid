# ──────────────────────────────────────────────────────────────────────────────
# DyslexAid Admin Server – Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env (never commit .env to source control)
# Usage:  cd server && cp .env.example .env  → fill in values → node index.js
# ──────────────────────────────────────────────────────────────────────────────

# Path to the Firebase Admin SDK service account JSON key.
# Download from: Firebase Console → Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase project ID (matches firebase.js projectId)
FIREBASE_PROJECT_ID=dyslexaid-fa29f

# Port the admin server listens on
PORT=3001

# Comma-separated list of allowed CORS origins (Vercel URL in production)
# Example: http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

