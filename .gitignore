# ── DyslexAid .gitignore additions ──────────────────────────────────────────
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Firebase Admin SDK service account key – NEVER commit these
serviceAccountKey.json
*serviceAccount*.json
*.serviceAccount.json

# Provisioning environment files
scripts/.env.provision
.env.provision
server/.env

# Local user backups
backups/
*.backup.json

# General env files (keep .env.provision.example committed as template)
.env
.env.local
.env.production

# Firebase Admin SDK credentials
**/*firebase-adminsdk*.json
**/*service-account*.json
**/serviceAccountKey.json

# Python cache and virtual environments
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/
