# ──────────────────────────────────────────────────────────────────────────────
# DyslexAid – Super Admin Provisioning Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.provision (do NOT commit .env.provision to git).
# Used ONLY by: scripts/provision-superadmin.js
# Never used by the React frontend or Vite build.
# ──────────────────────────────────────────────────────────────────────────────

# Absolute path to the Firebase Admin SDK service account JSON key.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# NEVER commit the JSON key file to source control.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase Auth UID of the account to promote to Super Admin.
# To find: Firebase Console → Authentication → Users → find the account → copy UID.
# This account must already exist in Firebase Authentication before running the script.
SUPERADMIN_UID=REPLACE_WITH_ACTUAL_UID

# (Optional) The email address associated with the Super Admin account.
# If provided, the provisioning script verifies that it matches the Firebase Auth user record.
SUPERADMIN_EMAIL=admin@yourdomain.com

